  {
   "cell_type": "code",
   "execution_count": 141,
   "id": "3abea7e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.neighbors import BallTree\n",
    "df_maestra = df_client_guatemala.dropna(\n",
    "    subset=[\"pos_latitude\", \"pos_longitude\"]\n",
    ").copy()\n",
    "df_ooc = out_of_coverage.dropna(subset=[\"Latitud\", \"Longitud\"]).copy()\n",
    "\n",
    "# Convertir a flotantes para evitar errores de tipo de dato\n",
    "df_maestra[\"pos_latitude\"] = pd.to_numeric(\n",
    "    df_maestra[\"pos_latitude\"], errors=\"coerce\"\n",
    ")\n",
    "df_maestra[\"pos_longitude\"] = pd.to_numeric(\n",
    "    df_maestra[\"pos_longitude\"], errors=\"coerce\"\n",
    ")\n",
    "df_ooc[\"Latitud\"] = pd.to_numeric(df_ooc[\"Latitud\"], errors=\"coerce\")\n",
    "df_ooc[\"Longitud\"] = pd.to_numeric(df_ooc[\"Longitud\"], errors=\"coerce\")\n",
    "\n",
    "df_maestra = df_maestra.dropna(subset=[\"pos_latitude\", \"pos_longitude\"])\n",
    "df_ooc = df_ooc.dropna(subset=[\"Latitud\", \"Longitud\"])\n",
    "\n",
    "# 2. Convertir coordenadas [Latitud, Longitud] a radianes\n",
    "coords_maestra_rad = np.radians(\n",
    "    df_maestra[[\"pos_latitude\", \"pos_longitude\"]].values\n",
    ")\n",
    "coords_ooc_rad = np.radians(df_ooc[[\"Latitud\", \"Longitud\"]].values)\n",
    "\n",
    "# 3. Construir el árbol de búsqueda sobre la base maestra\n",
    "tree = BallTree(coords_maestra_rad, metric=\"haversine\")\n",
    "\n",
    "# 4. Consultar los 3 puntos más cercanos (k=3)\n",
    "# distances_rad contiene las distancias en radianes; indices_maestra contiene las posiciones en df_maestra\n",
    "distances_rad, indices_maestra = tree.query(coords_ooc_rad, k=3)\n",
    "\n",
    "# 5. Convertir distancias a metros (Radio terrestre = 6,371,000 m)\n",
    "RADIO_TIERRA_METROS = 6371000.0\n",
    "distances_m = distances_rad * RADIO_TIERRA_METROS\n",
    "\n",
    "# 6. Guardar métricas (min, max, mean) de los 3 puntos más cercanos en out_of_coverage\n",
    "df_ooc[\"min_meters_top3\"] = np.round(\n",
    "    distances_m[:, 0], 2\n",
    ")  # Distancia al cliente 1 (más cercano)\n",
    "df_ooc[\"max_meters_top3\"] = np.round(\n",
    "    distances_m[:, 2], 2\n",
    ")  # Distancia al cliente 3\n",
    "df_ooc[\"mean_meters_top3\"] = np.round(\n",
    "    distances_m.mean(axis=1), 2\n",
    ")  # Promedio de los 3\n",
    "\n",
    "# Extraer los pos_id de los 3 clientes más cercanos encontrados\n",
    "ids_maestra = df_maestra[\"pos_id\"].values\n",
    "df_ooc[\"top_1_pos_id\"] = ids_maestra[indices_maestra[:, 0]]\n",
    "df_ooc[\"top_2_pos_id\"] = ids_maestra[indices_maestra[:, 1]]\n",
    "df_ooc[\"top_3_pos_id\"] = ids_maestra[indices_maestra[:, 2]]"
   ]
  },
