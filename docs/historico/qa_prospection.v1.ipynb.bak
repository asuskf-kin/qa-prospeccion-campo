    "    col_clean_user_name=\"¿Es correcto el nombre de Establecimiento ?\",\n",
    "    col_pos_name=\"pos_name\",\n",
    ")\n",
    "\n",
    "# Visualizar resultados clave\n",
    "columnas_resultado = [\n",
    "    \"Código de Cliente interno y Nombre de Establecimiento\",\n",
    "    \"¿Es correcto el nombre de Establecimiento ?\",\n",
    "    \"pos_name\",\n",
    "    \"nombre_evaluado\",\n",
    "    \"score_final\",\n",
    "    \"estatus_validacion\",\n",
    "    \"dataplor_id\",\n",
    "]"
   ]
