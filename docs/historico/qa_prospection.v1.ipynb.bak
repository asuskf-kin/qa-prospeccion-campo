  {
   "cell_type": "code",
   "execution_count": 56,
   "id": "110a55d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from rapidfuzz import fuzz\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from unidecode import unidecode"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "id": "a1123654",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. LIMPIEZA Y EXTRACCIÓN DE NOMBRE\n",
    "def extract_clean_name(text):\n",
    "    \"\"\"Extrae el nombre quitando códigos numéricos iniciales (ej: '2105.Smoothies Lios' -> 'smoothies lios')\n",
    "\n",
    "    y normaliza caracteres.\n",
    "    \"\"\"\n",
    "    if pd.isna(text) or not str(text).strip():\n",
    "        return \"\"\n",
    "\n",
    "    text = str(text)\n",
    "\n",
    "    # Si viene con formato '2105.Nombre' o '2105 - Nombre', eliminar el prefijo numérico\n",
    "    text = re.sub(r\"^\\d+[\\.\\-\\s]*\", \"\", text)\n",
    "\n",
    "    # Quitar acentos, convertir a minúsculas y limpiar caracteres especiales\n",
    "    text = unidecode(text).lower().strip()\n",
    "    text = re.sub(r\"[^a-z0-9\\s]\", \"\", text)\n",
    "    text = re.sub(r\"\\s+\", \" \", text)\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "def get_target_name(row, col_raw, col_user_clean):\n",
    "    \"\"\"Determina el nombre a validar:\n",
    "\n",
    "    - Si el usuario escribió un nombre limpio/corregido en 'col_user_clean', usa ese.\n",
    "    - Si no, limpia y extrae el nombre de 'col_raw'.\n",
    "    \"\"\"\n",
    "    raw_user_clean = (\n",
    "        \"\" if pd.isna(row[col_user_clean]) else str(row[col_user_clean]).strip()\n",
    "    )\n",
    "    clean_user = extract_clean_name(raw_user_clean)\n",
    "\n",
    "    # Si la columna del usuario tiene un valor válido (que no sea solo 'si', 'no' o vacía)\n",
    "    if clean_user and clean_user not in [\"si\", \"no\"]:\n",
    "        return clean_user\n",
    "\n",
    "    # Si no hay corrección del usuario, extrae el nombre del campo raw (quitando el código ID)\n",
    "    return extract_clean_name(row[col_raw])\n",
    "\n",
    "\n",
    "# 2. MÉTRICAS DE SIMILITUD\n",
    "def compute_tfidf_sim(text1, text2):\n",
    "    \"\"\"Similitud de subpalabras/caracteres mediante n-gramas TF-IDF.\"\"\"\n",
    "    if not text1 or not text2:\n",
    "        return 0.0\n",
    "    try:\n",
    "        vectorizer = TfidfVectorizer(analyzer=\"char_wb\", ngram_range=(2, 4))\n",
    "        tfidf = vectorizer.fit_transform([text1, text2])\n",
    "        return float(cosine_similarity(tfidf[0:1], tfidf[1:2])[0][0]) * 100\n",
    "    except ValueError:\n",
    "        return 0.0\n",
    "\n",
    "\n",
    "# 3. PIPELINE DE VALIDACIÓN\n",
    "def validate_client_names(\n",
    "    df, col_raw_name, col_clean_user_name, col_pos_name, ft_model=None\n",
    "):\n",
    "    results = []\n",
    "\n",
    "    for idx, row in df.iterrows():\n",
    "        # A. Nombre objetivo vs Nombre en Maestra\n",
    "        target_name = get_target_name(row, col_raw_name, col_clean_user_name)\n",
    "        pos_name = extract_clean_name(row[col_pos_name])\n",
    "\n",
    "        if not target_name or not pos_name:\n",
    "            results.append({\n",
    "                \"nombre_evaluado\": target_name,\n",
    "                \"pos_name_limpio\": pos_name,\n",
    "                \"score_final\": 0.0,\n",
    "                \"estatus_validacion\": \"SIN_DATOS_PARA_COMPARAR\",\n",
    "            })\n",
    "            continue\n",
    "\n",
    "        # B. Cálculo de Métricas\n",
    "        sim_ratio = fuzz.ratio(target_name, pos_name)\n",
    "        sim_token_set = fuzz.token_set_ratio(target_name, pos_name)\n",
    "        sim_tfidf = compute_tfidf_sim(target_name, pos_name)\n",
    "\n",
    "        # C. Score Ponderado (45% Token Set, 30% TF-IDF, 25% Levenshtein)\n",
    "        score_final = (\n",
    "            (sim_token_set * 0.45) + (sim_tfidf * 0.30) + (sim_ratio * 0.25)\n",
    "        )\n",
    "\n",
    "        # D. Clasificación de Validación\n",
    "        if score_final >= 88:\n",
    "            estatus = \"VALIDO_EXACTO\"\n",
    "        elif score_final >= 70:\n",
    "            estatus = \"VALIDO_SIMILAR\"\n",
    "        elif score_final >= 50:\n",
    "            estatus = \"REVISAR_MANUAL\"\n",
    "        else:\n",
    "            estatus = \"NO_COINCIDE\"\n",
    "\n",
    "        results.append({\n",
    "            \"nombre_evaluado\": target_name,\n",
    "            \"pos_name_limpio\": pos_name,\n",
    "            \"score_final\": round(score_final, 2),\n",
    "            \"estatus_validacion\": estatus,\n",
    "            \"fuzz_ratio\": round(sim_ratio, 2),\n",
    "            \"fuzz_token_set\": round(sim_token_set, 2),\n",
    "            \"tfidf_sim\": round(sim_tfidf, 2),\n",
    "        })\n",
    "\n",
    "    df_res = pd.DataFrame(results)\n",
    "    return pd.concat([df.reset_index(drop=True), df_res], axis=1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "7c6d88a6",
   "metadata": {},
   "outputs": [],
   "source": [
