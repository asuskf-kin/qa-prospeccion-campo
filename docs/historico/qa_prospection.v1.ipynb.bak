  {
   "cell_type": "code",
   "execution_count": 106,
   "id": "6a1a16e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from rapidfuzz import fuzz\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from unidecode import unidecode\n",
    "\n",
    "\n",
    "# 1. NORMALIZACIÓN INDIVIDUAL DE TEXTO DE DIRECCIÓN\n",
    "def clean_address_text(text):\n",
    "    \"\"\"Limpia y estandariza abreviaturas únicamente en la columna de dirección.\"\"\"\n",
    "    if pd.isna(text) or not str(text).strip():\n",
    "        return \"\"\n",
    "\n",
    "    text = str(text)\n",
    "    text = unidecode(text).lower().strip()\n",
    "\n",
    "    # Estandarización de abreviaturas frecuentes\n",
    "    reemplazos = {\n",
    "        r\"\\bcol\\b|\\bcolonia\\b\": \"colonia\",\n",
    "        r\"\\bave?\\b|\\bavenida\\b\": \"avenida\",\n",
    "        r\"\\bcll?\\b|\\bcalle\\b\": \"calle\",\n",
    "        r\"\\bz\\b|\\bzn\\b|\\bzona\\b\": \"zona\",\n",
    "        r\"\\bkm\\b|\\bkilometro\\b\": \"km\",\n",
    "        r\"\\bblvd?\\b|\\bbulevar\\b\": \"bulevar\",\n",
    "        r\"\\bno\\b|\\bnum\\b|\\bnumero\\b\": \"\",\n",
    "    }\n",
    "\n",
    "    for patron, reemplazo in reemplazos.items():\n",
    "        text = re.sub(patron, reemplazo, text)\n",
    "\n",
    "    text = re.sub(r\"[^a-z0-9\\s]\", \" \", text)\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "# 2. MÉTRICA DE SUBPALABRAS (TF-IDF)\n",
    "def compute_tfidf(text1, text2):\n",
    "    if not text1 or not text2:\n",
    "        return 0.0\n",
    "    try:\n",
    "        vectorizer = TfidfVectorizer(analyzer=\"char_wb\", ngram_range=(2, 4))\n",
    "        tfidf = vectorizer.fit_transform([text1, text2])\n",
    "        return float(cosine_similarity(tfidf[0:1], tfidf[1:2])[0][0]) * 100\n",
    "    except ValueError:\n",
    "        return 0.0\n",
    "\n",
    "\n",
    "# 3. COMPARACIÓN DIRECTA TEXTO A TEXTO\n",
    "def compare_address_text_only(\n",
    "    df, col_dir_formulario=\"Dirección\", col_dir_maestra=\"pos_addres\"\n",
    "):\n",
    "    results = []\n",
    "\n",
    "    for idx, row in df.iterrows():\n",
    "        dir_form = clean_address_text(row.get(col_dir_formulario, \"\"))\n",
    "        dir_maestra = clean_address_text(row.get(col_dir_maestra, \"\"))\n",
    "\n",
    "        if not dir_form or not dir_maestra:\n",
    "            results.append({\n",
    "                \"dir_form_limpia\": dir_form,\n",
    "                \"dir_maestra_limpia\": dir_maestra,\n",
    "                \"score_direccion\": 0.0,\n",
    "                \"estatus_direccion\": \"DIRECCION_VACIA\",\n",
    "            })\n",
    "            continue\n",
    "\n",
    "        # Métricas directas sobre el texto de la dirección\n",
    "        sim_token_set = fuzz.token_set_ratio(dir_form, dir_maestra)\n",
    "        sim_ratio = fuzz.ratio(dir_form, dir_maestra)\n",
    "        sim_tfidf = compute_tfidf(dir_form, dir_maestra)\n",
    "\n",
    "        # Score ponderado\n",
    "        score = (sim_token_set * 0.50) + (sim_tfidf * 0.30) + (sim_ratio * 0.20)\n",
    "\n",
    "        # Criterio de clasificación\n",
    "        if score >= 85:\n",
    "            estatus = \"CORRECTA_EXACTA\"\n",
    "        elif score >= 65:\n",
    "            estatus = \"CORRECTA_SIMILAR\"\n",
    "        elif score >= 45:\n",
    "            estatus = \"REVISAR_MANUAL\"\n",
    "        else:\n",
    "            estatus = \"DESCARTAR_DIFERENTE\"\n",
    "\n",
    "        results.append({\n",
    "            \"dir_form_limpia\": dir_form,\n",
    "            \"dir_maestra_limpia\": dir_maestra,\n",
    "            \"score_direccion\": round(score, 2),\n",
    "            \"estatus_direccion\": estatus,\n",
    "            \"fuzz_token_set\": round(sim_token_set, 2),\n",
    "            \"tfidf_sim\": round(sim_tfidf, 2),\n",
    "        })\n",
    "\n",
    "    df_res = pd.DataFrame(results)\n",
    "    return pd.concat([df.reset_index(drop=True), df_res], axis=1)\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# EJECUCIÓN\n",
    "# -------------------------------------------------------------------------\n",
    "df_evaluado_adress = compare_address_text_only(\n",
    "    df=review_other_case,\n",
    "    col_dir_formulario=\"Dirección\",\n",
    "    col_dir_maestra=\"pos_addres\",\n",
    ")\n"
   ]
  },
