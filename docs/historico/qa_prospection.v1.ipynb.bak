    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# 1. CÁLCULO DE DISTANCIA EN METROS (HAVERSINE)\n",
    "def haversine_vectorized(lat1, lon1, lat2, lon2):\n",
    "    \"\"\"Calcula la distancia geográfica real en metros entre dos pares de coordenadas.\"\"\"\n",
    "    R = 6371000.0  # Radio medio de la Tierra en metros\n",
    "\n",
    "    # Convertir grados decimales a radianes\n",
    "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n",
    "\n",
    "    dlat = lat2 - lat1\n",
    "    dlon = lon2 - lon1\n",
    "\n",
    "    a = (\n",
    "        np.sin(dlat / 2.0) ** 2\n",
    "        + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2.0) ** 2\n",
    "    )\n",
    "    c = 2 * np.arcsin(np.sqrt(a))\n",
    "\n",
    "    return R * c\n",
    "\n",
    "\n",
    "# 2. COMPARACIÓN Y CLASIFICACIÓN DE COORDENADAS\n",
    "def compare_coordinates_only(\n",
    "    df,\n",
    "    col_lat_form=\"Latitud\",\n",
    "    col_lon_form=\"Longitud\",\n",
    "    col_lat_pos=\"pos_latitude\",\n",
    "    col_lon_pos=\"pos_longitude\",\n",
    "    tolerancia_metros=100,\n",
    "):\n",
    "    df_eval = df.copy()\n",
    "\n",
    "    # Convertir a flotantes/numérico (convierte errores o celdas vacías en NaN)\n",
    "    lat1 = pd.to_numeric(df_eval[col_lat_form], errors=\"coerce\")\n",
    "    lon1 = pd.to_numeric(df_eval[col_lon_form], errors=\"coerce\")\n",
    "    lat2 = pd.to_numeric(df_eval[col_lat_pos], errors=\"coerce\")\n",
    "    lon2 = pd.to_numeric(df_eval[col_lon_pos], errors=\"coerce\")\n",
    "\n",
    "    # Calcular distancia vectorial en metros\n",
    "    df_eval[\"distancia_metros\"] = haversine_vectorized(lat1, lon1, lat2, lon2)\n",
    "\n",
    "    # Reglas de decisión para categorizar y descartar\n",
    "    condiciones = [\n",
    "        df_eval[\"distancia_metros\"].isna(),\n",
    "        df_eval[\"distancia_metros\"] <= 20,  # Coincidencia casi exacta (mismo local)\n",
    "        df_eval[\"distancia_metros\"]\n",
    "        <= tolerancia_metros,  # Margen normal de antena GPS\n",
    "        df_eval[\"distancia_metros\"]\n",
    "        <= (tolerancia_metros * 5),  # Desviación moderada (revisar)\n",
    "        df_eval[\"distancia_metros\"] > (tolerancia_metros * 5),  # Punto muy lejano\n",
    "    ]\n",
    "\n",
    "    categorias = [\n",
    "        \"COORDENADA_VACIA\",\n",
    "        \"CORRECTA_EXACTA\",\n",
    "        \"CORRECTA_TOLERANCIA\",\n",
    "        \"REVISAR_MANUAL\",\n",
    "        \"DESCARTAR_DIFERENTE\",\n",
    "    ]\n",
    "\n",
    "    df_eval[\"estatus_coordenadas\"] = np.select(\n",
    "        condiciones, categorias, default=\"SIN_DATOS\"\n",
    "    )\n",
    "    df_eval[\"distancia_metros\"] = df_eval[\"distancia_metros\"].round(2)\n",
    "\n",
    "    return df_eval\n",
    "\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# EJECUCIÓN\n",
    "# -------------------------------------------------------------------------\n",
    "df_evaluado_geo = compare_coordinates_only(\n",
    "    df=review_other_case,\n",
    "    col_lat_form=\"Latitud\",\n",
    "    col_lon_form=\"Longitud\",\n",
    "    col_lat_pos=\"pos_latitude\",\n",
    "    col_lon_pos=\"pos_longitude\",\n",
    "    tolerancia_metros=100,  # 100 metros de margen aceptable\n",
    ")\n",
    "\n",
    "# Visualizar resultados\n",
    "columnas_geo = [\n",
    "    \"Código de Cliente interno y Nombre de Establecimiento\",\n",
    "    \"pos_name\",\n",
    "    \"pos_id\",\n",
    "    \"Latitud\",\n",
    "    \"Longitud\",\n",
    "    \"pos_latitude\",\n",
    "    \"pos_longitude\",\n",
    "    \"distancia_metros\",\n",
    "    \"estatus_coordenadas\",\n",
    "]\n",
    "\n",
    "df_evaluado_geo[columnas_geo].head()"
   ]
  },
