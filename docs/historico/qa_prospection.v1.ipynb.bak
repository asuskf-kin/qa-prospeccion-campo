   "source": [
    "from scipy.stats import mannwhitneyu, ks_2samp\n",
    "\n",
    "ne = non_existent_establishment[\n",
    "    non_existent_establishment['DATOS DE VISITA'].astype(str)\n",
    "        .str.upper().str.contains('NO EXISTE', na=False)]\n",
    "ids_ne = set(ne['dataplor_id'].dropna())\n",
    " \n",
    "df = df_dataplor.copy()\n",
    "df['validity_score'] = pd.to_numeric(df['validity_score'], errors='coerce')\n",
    "df['NO_EXISTE'] = df['dataplor_id'].isin(ids_ne)\n",
    " \n",
    "caso    = df.loc[df.NO_EXISTE,  'validity_score'].dropna()\n",
    "control = df.loc[~df.NO_EXISTE, 'validity_score'].dropna()\n",
    " \n",
    "print(f\"base: {len(df):,} POIs | casos NO EXISTE: {df.NO_EXISTE.sum()} \"\n",
    "      f\"| cruzados con validity_score: {len(caso)}\")\n",
    "print(f\"nulos en validity_score -> casos: {df.loc[df.NO_EXISTE,'validity_score'].isna().sum()} \"\n",
    "      f\"| base: {df['validity_score'].isna().mean():.4f}\")\n",
    " \n",
    "# ------------------------------------------------ 2. distribucion comparada\n",
    "print(\"\\n=== distribucion de validity_score ===\")\n",
    "desc = pd.DataFrame({\n",
    "    'NO_EXISTE': caso.describe(percentiles=[.05,.25,.5,.75,.95]),\n",
    "    'RESTO':     control.describe(percentiles=[.05,.25,.5,.75,.95])}).round(4)\n",
    "print(desc.to_string())\n",
    " \n",
    "# ------------------------------------------------ 3. tests de separacion\n",
    "u, p_mw = mannwhitneyu(caso, control, alternative='two-sided')\n",
    "auc = u / (len(caso) * len(control))\n",
    "ks, p_ks = ks_2samp(caso, control)\n",
    "print(f\"\\nAUC (Mann-Whitney) = {auc:.3f}   p = {p_mw:.2e}\")\n",
    "print(f\"KS = {ks:.3f}   p = {p_ks:.2e}\")\n",
    "print(\"interpretacion: AUC=0.50 no discrimina | AUC<0.50 validity BAJO asociado a NO EXISTE \"\n",
    "      \"| AUC>0.50 validity ALTO asociado a NO EXISTE (direccion contraria a la esperada)\")\n",
    " \n",
    "# --------------------------- 4. ¿en que percentil de la base caen los casos?\n",
    "pct = caso.apply(lambda v: (control < v).mean())\n",
    "print(\"\\n=== percentil de cada caso dentro de la base ===\")\n",
    "print(f\"mediana del percentil: {pct.median():.3f}  (0.50 = indistinguible del promedio)\")\n",
    "for lim in [0.05, 0.10, 0.25, 0.50]:\n",
    "    print(f\"  casos bajo el percentil {int(lim*100):>2}: {int((pct<lim).sum()):>2}/{len(pct)}\"\n",
    "          f\"  ({(pct<lim).mean():.3f})   esperado si fuera aleatorio: {lim:.3f}\")\n",
    " \n",
    "# ------------- 5. poder de filtrado: barrer todos los umbrales de corte\n",
    "print(\"\\n=== curva de decision: filtrar POIs con validity_score < umbral ===\")\n",
    "prev = df.NO_EXISTE.mean()\n",
    "print(f\"{'umbral':>7}{'recall':>9}{'%base marcada':>15}{'precision':>11}{'lift':>7}\")\n",
    "for thr in [0.30,0.40,0.50,0.60,0.70,0.75,0.80,0.85,0.90,0.95,0.99]:\n",
    "    m = (df.validity_score < thr).fillna(False)\n",
    "    r = m[df.NO_EXISTE].mean()\n",
    "    b = m.mean()\n",
    "    prec = df.NO_EXISTE[m].mean() if m.sum() else np.nan\n",
    "    print(f\"{thr:>7.2f}{r:>9.3f}{b:>15.3f}{prec:>11.5f}{(prec/prev if m.sum() else np.nan):>7.2f}\")\n",
    "print(f\"prevalencia base = {prev:.5f}  (lift 1.00 = el umbral no aporta nada)\")\n",
    " \n",
    "# ---------------- 6. control del sesgo geografico (solo depts. visitados)\n",
    "deptos = set(df.loc[df.NO_EXISTE, 'state'].dropna())\n",
    "sub = df[df['state'].isin(deptos)]\n",
    "a = sub.loc[sub.NO_EXISTE, 'validity_score'].dropna()\n",
    "b = sub.loc[~sub.NO_EXISTE, 'validity_score'].dropna()\n",
    "u2, p2 = mannwhitneyu(a, b, alternative='two-sided')\n",
    "print(f\"\\n=== controlado por departamento ({', '.join(sorted(deptos))}) ===\")\n",
    "print(f\"casos={len(a)} controles={len(b)} | AUC={u2/(len(a)*len(b)):.3f} p={p2:.2e} \"\n",
    "      f\"| mediana caso={a.median():.4f} vs control={b.median():.4f}\")\n",
    " \n",
    "# ---------------- 7. relacion validity_score vs las variables de estado\n",
    "print(\"\\n=== validity_score frente a las columnas de estado ===\")\n",
    "for c in ['open_closed_status','dataplor_status','closed_on']:\n",
    "    print(f\"{c}: {df[c].nunique(dropna=True)} valor(es) distinto(s) -> \"\n",
    "          f\"{dict(df[c].value_counts(dropna=False))}\")\n",
    "print(\"nota: con estas columnas constantes, validity_score no puede estar codificando cierre.\")\n",
    " \n",
    "# ---------------- 8. detalle caso por caso\n",
    "det = (df.loc[df.NO_EXISTE, ['dataplor_id','name','state','validity_score',\n",
    "                             'data_quality_confidence_score','open_closed_status',\n",
    "                             'open_closed_status_confidence_score','number_of_reviews']]\n",
    "         .assign(percentil_en_base=pct.values)\n",
    "         .sort_values('validity_score'))\n",
    "print(\"\\n=== los 35 casos ordenados por validity_score ===\")\n",
    "print(det.to_string(index=False))\n",
    "det.to_csv('validity_score_casos.csv', index=False)\n",
    " "
   ]
  },
